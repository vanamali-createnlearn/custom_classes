-- POST-PROCESSING EFFECTS

local function getEffect(name, className)
	local effect = Lighting:FindFirstChild(name)

	if effect and effect.ClassName == className then
		return effect
	end

	if effect then
		effect:Destroy()
	end

	effect = Instance.new(className)
	effect.Name = name
	effect.Parent = Lighting

	return effect
end

