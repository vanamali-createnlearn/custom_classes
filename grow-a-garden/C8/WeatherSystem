local function tweenProperties(instance, properties)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(
			TRANSITION_TIME,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut
		),
		properties
	)

	tween:Play()
end

-- LIGHTNING FLASHES

local function startLightning(version)
	task.spawn(function()
		while weatherVersion == version
			and currentWeather == "Thunderstorm" do

			task.wait(rng:NextNumber(1.0, 2.0))

			if weatherVersion ~= version
				or currentWeather ~= "Thunderstorm" then
				break
			end

			tweenProperties(lightningFlash, {
				Brightness = 0.85,
				Contrast = 0.25,
			})

			task.wait(0.09)

			lightningFlash.Brightness = 0
			lightningFlash.Contrast = 0

			task.wait(0.08)

			if weatherVersion == version
				and currentWeather == "Thunderstorm" then

				lightningFlash.Brightness = 0.35
				task.wait(0.05)
				lightningFlash.Brightness = 0
			end
		end
	end)
end

-- APPLY WEATHER

local function applyWeather(name)
	local preset = weather[name]

	if not preset then
		return
	end

	weatherVersion += 1
	local version = weatherVersion

	currentWeather = name

	-- Other scripts can read these attributes later.
	-- CropGrowthManager must use the multiplier for it to
	-- actually shorten crop growth time.
	Workspace:SetAttribute("CurrentWeather", name)
	Workspace:SetAttribute(
		"CropGrowthTimeMultiplier",
		preset.GrowthMultiplier
	)

	tweenProperties(Lighting, preset.Lighting)
	tweenProperties(atmosphere, preset.Atmosphere)
	tweenProperties(clouds, preset.Clouds)
	tweenProperties(colorCorrection, preset.ColorCorrection)
	tweenProperties(bloom, preset.Bloom)

	Workspace.GlobalWind = preset.Wind

	lightningFlash.Brightness = 0
	lightningFlash.Contrast = 0

	for _, pair in ipairs(emitters) do
		pair.Rain.Rate = preset.RainRate
		pair.Rain.Enabled = preset.RainRate > 0

		pair.Snow.Rate = preset.SnowRate
		pair.Snow.Enabled = preset.SnowRate > 0
	end

	if name == "Thunderstorm" then
		startLightning(version)
	end

	print("Weather changed to:", name)
end

-- RANDOM WEATHER EVERY 5 SECONDS

while true do
	task.wait(CHANGE_INTERVAL)

	local choices = {}

	for _, name in ipairs(weatherNames) do
		if name ~= currentWeather then
			table.insert(choices, name)
		end
	end

	local selectedWeather = choices[
		rng:NextInteger(1, #choices)
	]

	applyWeather(selectedWeather)
end
