local function getGroundCenter()
	local ground = Workspace:FindFirstChild("Baseplate")
		or Workspace:FindFirstChild("Ground")

	if ground and ground:IsA("BasePart") then
		return Vector3.new(
			ground.Position.X,
			ground.Position.Y + ground.Size.Y / 2,
			ground.Position.Z
		)
	end

	if ground and ground:IsA("Model") then
		local cf, size = ground:GetBoundingBox()

		return Vector3.new(
			cf.Position.X,
			cf.Position.Y + size.Y / 2,
			cf.Position.Z
		)
	end

	return Vector3.zero
end

