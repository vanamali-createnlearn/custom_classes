--place inside serverscriptservice
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local GAMEPASS_ID =  -- Replace with your Game Pass ID

local function setCollisionGroup(character, groupName)
	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			object.CollisionGroup = groupName
		end
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)

		local ownsPass = false

		local success, result = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, GAMEPASS_ID)
		end)

		if success and result then
			ownsPass = true
		end

		if ownsPass then
			setCollisionGroup(character, "VIPPlayer")
		else
			setCollisionGroup(character, "Default")
		end

	end)
end)
